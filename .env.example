POSTGRES_DB=insightflow
POSTGRES_USER=insightflow
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_READER_PASSWORD=replace_with_a_different_local_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
SEMANTIC_DIR=/semantic
CDISC_PSEUDONYM_SALT=replace_with_a_long_random_secret
INSIGHTFLOW_AUTH_MODE=development
CLINICAL_INLINE_JOBS=true
# V17 is the canonical runtime. Set v16 only for an explicit emergency rollback.
INSIGHTFLOW_RUNTIME_VERSION=v17
# V16 is an emergency-only path: all three fields are required and the timestamp must be future
# dated (ISO-8601 with timezone). These values are audited on every V16 execution.
# INSIGHTFLOW_V16_FALLBACK_OWNER=incident-owner@example.com
# INSIGHTFLOW_V16_FALLBACK_REASON=INC-0000 Graph canary rollback
# INSIGHTFLOW_V16_FALLBACK_UNTIL=2026-09-22T23:59:59Z
# V18 运行时端口：memory（默认）或 redis；Redis 只存缓存、检查点和幂等锁，不存最终临床事实。
INSIGHTFLOW_RUNTIME_PORTS=memory
INSIGHTFLOW_REDIS_URL=redis://localhost:6379/0
INSIGHTFLOW_REDIS_NAMESPACE=insightflow
INSIGHTFLOW_RUNTIME_TTL_SECONDS=3600
# V19 追踪：noop（默认）或 opentelemetry/logfire；只记录脱敏运行元数据。
INSIGHTFLOW_TELEMETRY=noop
# V18 Temporal 连接参数（V18 只定义边界，V19 再启用实际工作流服务）。
INSIGHTFLOW_TEMPORAL_TARGET=localhost:7233
INSIGHTFLOW_TEMPORAL_NAMESPACE=default
INSIGHTFLOW_TEMPORAL_TASK_QUEUE=clinical-v20
# V22 Temporal 默认关闭；开启前请配置真实集群和短期审批恢复密钥。
INSIGHTFLOW_TEMPORAL_ENABLED=false
INSIGHTFLOW_APPROVAL_RESUME_SECRET=
INSIGHTFLOW_APPROVAL_RESUME_TTL_SECONDS=900
INSIGHTFLOW_TEMPORAL_OUTBOX_MAX_ATTEMPTS=5
INSIGHTFLOW_TEMPORAL_OUTBOX_POLL_SECONDS=5
INSIGHTFLOW_TEMPORAL_OUTBOX_BATCH_SIZE=20
# V22 本地可选 Temporal 集群（仅开发验收；生产请使用独立受管集群）。
TEMPORAL_VERSION=1.29.1
TEMPORAL_UI_VERSION=2.34.0

# V2.1 defaults to offline rules and makes no paid external call.
INSIGHTFLOW_LLM_MODE=offline_rules
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
ZHIPU_API_KEY=
GLM_MODEL=
MOONSHOT_API_KEY=
KIMI_MODEL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_BASE_URL=

